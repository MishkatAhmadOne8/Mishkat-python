
import numpy as np

def get_user_matrix(rows, cols):
    print(f"Enter {rows * cols} elements for a {rows}x{cols} matrix (space-separated):")
    elements = list(map(float, input().split()))
    return np.array(elements).reshape(rows, cols)

# Get 5x3 matrix from user
print("--- Matrix 1 ---")
matrix1 = get_user_matrix(5, 3)

