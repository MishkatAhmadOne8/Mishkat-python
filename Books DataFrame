import pandas as pd

# Read CSV file
df = pd.read_csv("books.csv")

# a) Print complete report
print("\nComplete Book Report:\n")
print(df)

# b) Books of a given author
author_name = input("\nEnter author name: ")
print("\nBooks by author:\n")
print(df[df['author'] == author_name])

# c) Books of a given publisher
publisher_name = input("\nEnter publisher name: ")
print("\nBooks by publisher:\n")
print(df[df['publisher'] == publisher_name])

# d) Cheapest and costliest book
cheapest = df[df['price'] == df['price'].min()]
costliest = df[df['price'] == df['price'].max()]

print("\nCheapest Book:\n", cheapest[['title']])
print("\nCostliest Book:\n", costliest[['title']])

# e) Sort by year
print("\nBooks sorted by year:\n")
print(df.sort_values(by='year'))
