import matplotlib.pyplot as plt

# Sample recruitment data
companies = ['Microsoft', 'Google', 'Amazon', 'IBM', 'Deloitte', 'Capgemini', 'ATOS Origin', 'Amdocs']
recruitments = [1200, 1500, 1100, 900, 800, 950, 600, 750]

# a) Bar Chart
plt.figure(figsize=(12, 5))
plt.bar(companies, recruitments, color='skyblue')
plt.title('New Recruitments by Company')
plt.show()

# b) Pie Chart
plt.figure(figsize=(8, 8))
plt.pie(recruitments, labels=companies, autopct='%1.1f%%')
plt.title('Recruitment Distribution')
plt.show()

# c) Customized Pie Chart (Exploded and Styled)
explode = [0.1 if (c == 'IBM' or c == 'Amdocs') else 0 for c in companies]
plt.figure(figsize=(8, 8))
plt.pie(recruitments, labels=companies, explode=explode, shadow=True, startangle=140)
plt.title('Customized Recruitment Pie Chart (Highlighting IBM/Amdocs)')
plt.show()

# d) Doughnut Chart
plt.figure(figsize=(8, 8))
plt.pie(recruitments, labels=companies, autopct='%1.1f%%', pctdistance=0.85)
# Add a circle at the center to make it a doughnut
centre_circle = plt.Circle((0,0), 0.70, fc='white')
fig = plt.gcf()
fig.gca().add_artist(centre_circle)
plt.title('Recruitment Doughnut Chart')
plt.show()

# Comparison: IBM & Amdocs
comp_names = ['IBM', 'Amdocs']
comp_values = [recruitments[companies.index('IBM')], recruitments[companies.index('Amdocs')]]
plt.figure(figsize=(6, 4))
plt.bar(comp_names, comp_values, color=['blue', 'orange'])
plt.title('Comparison: IBM vs Amdocs')
plt.ylabel('New Recruitments')
plt.show()
